{
  "manifest_version": 3,
  "name": "Youtube Toggle",
  "description": "Quick toggle between youtube videos, shorts and music.",
  "version": "1.0",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting"],
  "commands": {
    "toggleYoutubeMusic": {
      "suggested_key": {
        "default": "Ctrl+Q",
        "mac": "Command+Q"
      },
      "description": "Toggles opened url"
    },
    "toggleYoutubeShort": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "Command+Shift+Q"
      },
      "description": "Toggles opened short url"
    }
  },
  "action": {},
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["content-script.js"]
    }
  ]
}
